{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/media-summary-app"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://media-summary-back.onrender.com/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
